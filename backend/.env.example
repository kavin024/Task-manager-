DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=student_task_manager

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=https://kavin024.github.io,http://localhost:5173,http://127.0.0.1:5173

# Public frontend URL used in the "Open NEXUS" button inside reminder emails.
FRONTEND_URL=https://kavin024.github.io/Task-manager-/

# Daily reminder email delivery (leave blank to disable sending).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=reminders@example.com

# Shared secret the scheduled GitHub Action sends as the X-Reminder-Token header.
REMINDER_JOB_TOKEN=generate_a_long_random_string